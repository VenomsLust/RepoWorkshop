<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RepoWorkshop.App"
             xmlns:local="using:RepoWorkshop"
             RequestedThemeVariant="Dark">
             <!-- Overridden at startup from the Theme setting (Dark / Light / System). -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="DividerBrush" Color="#40808080" />
            <SolidColorBrush x:Key="PanelBrush" Color="#14808080" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#D13438" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#2E8BD8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#6CB8F5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.secondary">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        </Style>
        <Style Selector="TextBlock.branch">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.head">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        </Style>

        <Style Selector="StackPanel.toolbar">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="StackPanel.toolbar > Button">
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="StackPanel.toolbar > Separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="{StaticResource DividerBrush}" />
        </Style>
    </Application.Styles>
</Application>
