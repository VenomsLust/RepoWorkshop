<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RepoWorkshop.ViewModels"
        x:Class="RepoWorkshop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="620" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Classes="subtitle" Text="Appearance" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Theme" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="140" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="subtitle" Text="WinMerge" />
            <TextBlock Classes="secondary small" TextWrapping="Wrap"
                       Text="Path to WinMergeU.exe. Leave empty to use the auto-detected installation." />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseWinMergeCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding WinMergePath}" PlaceholderText="{Binding DetectedWinMergePath}" />
            </DockPanel>
            <TextBlock Classes="secondary small" Text="{Binding DetectedWinMergePath, StringFormat='Detected: {0}'}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="subtitle" Text="Branch comparison" />
            <CheckBox IsChecked="{Binding CompareFromMergeBase}"
                      Content="Compare from the merge base (show only what the other branch changed)" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="subtitle" Text="Automation" />
            <CheckBox IsChecked="{Binding ApiEnabled}"
                      Content="Enable the local API (rw command and LLM agents)" />
            <TextBlock Classes="secondary small" TextWrapping="Wrap"
                       Text="Only programs running as your Windows user can connect. Destructive actions always ask you first." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Save" Classes="accent" IsDefault="True" MinWidth="80" Click="OnSave" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
