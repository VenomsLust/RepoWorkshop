<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RepoWorkshop.ViewModels"
             xmlns:m="using:RepoWorkshop.Models"
             xmlns:views="using:RepoWorkshop.Views"
             x:Class="RepoWorkshop.Views.WorkingFilesPanel"
             x:DataType="vm:ChangesViewModel">

    <!-- The border lights up in the accent colour whenever there are uncommitted changes. -->
    <Border Classes="panel" Classes.highlight="{Binding HasFiles}" Margin="0,8,0,0">
        <DockPanel>
            <!-- Title with a count badge, and a legend for staged files -->
            <DockPanel DockPanel.Dock="Top" Margin="12,10,12,4">
                <TextBlock DockPanel.Dock="Right" Classes="small staged" Text="staged" VerticalAlignment="Center"
                           ToolTip.Tip="Staged files are shown in green italics" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="subtitle" Text="Changed files" VerticalAlignment="Center" />
                    <Border Classes="badge" IsVisible="{Binding HasFiles}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Files.Count}" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Common actions on the selection; Revert and Delete are in the right-click menu -->
            <WrapPanel DockPanel.Dock="Top" Classes="toolbar" Margin="12,4,12,8">
                <Button Content="Stage" Command="{Binding StageFilesCommand}"
                        CommandParameter="{Binding #FilesList.SelectedItems}" ToolTip.Tip="Stage the selected files" />
                <Button Content="Unstage" Command="{Binding UnstageFilesCommand}"
                        CommandParameter="{Binding #FilesList.SelectedItems}" ToolTip.Tip="Unstage the selected staged files" />
                <Button Content="Diff" Command="{Binding DiffFilesCommand}"
                        CommandParameter="{Binding #FilesList.SelectedItems}" ToolTip.Tip="Compare the selected files with the last commit in WinMerge" />
            </WrapPanel>

            <Border DockPanel.Dock="Top" Classes="conflict-banner" IsVisible="{Binding HasConflicts}" Margin="12,0,12,8">
                <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap" />
            </Border>

            <TextBlock DockPanel.Dock="Bottom" Classes="small secondary" Margin="12,6,12,8" TextWrapping="Wrap"
                       Text="Ctrl/Shift-click to select several · double-click to diff (or resolve a conflict) · right-click for more" />

            <Panel>
                <ListBox x:Name="FilesList" ItemsSource="{Binding Files}" SelectionMode="Multiple" Background="Transparent"
                         views:ItemDoubleClick.Command="{Binding DiffFileCommand}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12,4" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Stage" Command="{Binding StageFilesCommand}"
                                      CommandParameter="{Binding #FilesList.SelectedItems}" />
                            <MenuItem Header="Unstage" Command="{Binding UnstageFilesCommand}"
                                      CommandParameter="{Binding #FilesList.SelectedItems}" />
                            <MenuItem Header="Revert…" Command="{Binding RevertFilesCommand}"
                                      CommandParameter="{Binding #FilesList.SelectedItems}" />
                            <MenuItem Header="Diff" Command="{Binding DiffFilesCommand}"
                                      CommandParameter="{Binding #FilesList.SelectedItems}" />
                            <MenuItem Header="Resolve in WinMerge…" Command="{Binding ResolveConflictsCommand}"
                                      CommandParameter="{Binding #FilesList.SelectedItems}" />
                            <Separator />
                            <MenuItem Header="Delete…" Command="{Binding DeleteFilesCommand}"
                                      CommandParameter="{Binding #FilesList.SelectedItems}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:WorkingFile">
                            <DockPanel ToolTip.Tip="{Binding StateText}">
                                <TextBlock DockPanel.Dock="Left" Classes="mono small secondary" Text="{Binding Code}" Width="28"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayPath}" Classes.staged="{Binding IsStaged}"
                                           Classes.conflict="{Binding IsConflict}"
                                           TextTrimming="PrefixCharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Classes="secondary" Text="No changes — working tree is clean." IsVisible="{Binding !HasFiles}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
