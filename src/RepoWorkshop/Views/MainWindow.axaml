<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RepoWorkshop.ViewModels"
        xmlns:svc="using:RepoWorkshop.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="RepoWorkshop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="820" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Title="Repo Workshop">

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Classes="toolbar">
                    <ToggleButton Content="Log" IsChecked="{Binding IsLogVisible}" Padding="10,4" />
                    <Button Content="Settings…" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
                <TextBlock Classes="title" Text="Repo Workshop" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,4" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="small secondary" Text="{Binding WinMergeStatus}" Margin="16,0,0,0" />
                <TextBlock Classes="small" Classes.error="{Binding StatusIsError}" Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Log panel -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsLogVisible}" Height="200"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,6">
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}" Padding="8,2" />
                    <TextBlock Classes="section" Text="OUTPUT" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" Background="Transparent">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:LogEntry">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Classes="mono small secondary" Text="{Binding TimeText}" Width="70" />
                                <TextBlock Classes="mono small" Classes.error="{Binding IsError}" Classes.branch="{Binding IsCommand}"
                                           Text="{Binding Text}" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="240,Auto,*">
            <!-- Projects sidebar -->
            <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
                <DockPanel DockPanel.Dock="Top" Margin="12,12,8,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                        <Button Content="+" ToolTip.Tip="New project" Command="{Binding AddProjectCommand}" Padding="8,2" />
                        <Button Content="✎" ToolTip.Tip="Rename project" Command="{Binding RenameProjectCommand}" Padding="8,2" />
                        <Button Content="✕" ToolTip.Tip="Remove project" Command="{Binding RemoveProjectCommand}" Padding="8,2" />
                    </StackPanel>
                    <TextBlock Classes="section" Text="PROJECTS" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectViewModel">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="small secondary" Text="{Binding SummaryText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource DividerBrush}" ResizeDirection="Columns" />

            <!-- Selected project -->
            <Panel Grid.Column="2">
                <ContentControl Content="{Binding SelectedProject}" />
                <StackPanel IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNull}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Classes="subtitle" Text="No project selected" HorizontalAlignment="Center" />
                    <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                               Text="Create a project, then add one or more git repositories to it." />
                    <Button Content="New project…" Command="{Binding AddProjectCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Panel>
        </Grid>
    </DockPanel>
</Window>
