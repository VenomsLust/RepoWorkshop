root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,axaml,xml,json,slnx}]
indent_size = 2

[*.cs]
indent_size = 4

# Braces at the end of the line (K&R style), including else/catch/finally.
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false

# Always use braces for control-flow bodies.
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# Explicit types instead of var.
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0008.severity = warning

csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Public members need XML doc comments (see Directory.Build.props).
dotnet_diagnostic.CS1591.severity = warning
